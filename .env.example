# ---------------------------------------------------------------------------
# Affiliate Hub backend configuration.
# Copy to .env, then replace every "change-me" value. The server validates this
# file on startup and refuses to boot while any secret is missing or a
# placeholder. Generate real values with:  npm run gen:secrets
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Transactions need a replica set: Atlas provides one; locally see README.
MONGODB_URI=mongodb://localhost:27017/affiliate?replicaSet=rs0

# At least 32 characters.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Shared with the external store that calls POST /api/conversions (x-api-key header).
CONVERSION_API_KEY=change-me

# 64 hex characters (32 bytes). Encrypts affiliate bank/UPI details at rest (AES-256-GCM).
PAYOUT_DETAILS_KEY=change-me

# Comma-separated browser origins allowed to call the API (the dashboard).
# Production: only the deployed dashboard origin, e.g. https://affiliate-dashboard.vercel.app
CORS_ORIGINS=http://localhost:3000

# Enables POST /api/admin/demo/simulate-sale for ops. Keep true for the reviewer demo only.
DEMO_MODE=true

# Prefix for the shareable referral link shown in the app (the code is appended).
REFERRAL_BASE_URL=https://shop.example.com/?ref=

# Number of reverse proxies in front of the app (Render: 1). Used for rate limiting by client IP.
TRUST_PROXY=0

LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
